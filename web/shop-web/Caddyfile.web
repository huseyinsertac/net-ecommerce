:80 {
	root * /srv
	# index.html (served for / and every SPA route) must revalidate; hashed assets can be cached.
	@index not path *.js *.css *.png *.jpg *.svg *.ico *.woff *.woff2 *.json *.txt /images/*
	header @index Cache-Control "no-cache"
	# Curated photos are immutable per key; cache for a week.
	@images path /images/*
	header @images Cache-Control "public, max-age=604800"
	try_files {path} /index.html
	file_server
	encode zstd gzip
}
