{
  "App": {
    "Name": "VoltLane"
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedOnStartup": true
  },
  "Jwt": {
    "Issuer": "voltlane",
    "Audience": "voltlane-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Payments": {
    "Provider": "Fake",
    "Timeout": "00:30:00",
    "ExpiryScanInterval": "00:01:00"
  },
  "AllowedHosts": "*"
}
