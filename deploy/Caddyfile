{$SITE_ADDRESS} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }
  @api path /api/* /health* /scalar* /openapi/*
  reverse_proxy @api api:8080
  reverse_proxy web:80
}
